# Copie este arquivo para .env e preencha. O .env nunca deve ir para o controle de versão.

# Chave da Exa API (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# Chave do Firecrawl (https://www.firecrawl.dev/app/api-keys) — busca de notícias
FIRECRAWL_API_KEY=

# Opcionais
# RADAR_TZ=America/Fortaleza
# RADAR_HORA=8
# RADAR_MINUTO=0
# RADAR_DB_PATH=data/radar.db
# RADAR_TERMS_PATH=config/termos.yaml

# Webhook de entrada do Bitrix24 (envio de leads pelos cards). Inclui o token: não versionar.
# Formato: https://<conta>.bitrix24.com.br/rest/<id-usuario>/<token>/
BITRIX_WEBHOOK_URL=

# Supabase (banco e imagens persistentes — necessário no Streamlit Cloud). Sem SUPABASE_DB_URL, usa data/radar.db.
# Connection string em: Supabase → Project Settings → Database → Connection string → "Session pooler" (IPv4)
SUPABASE_DB_URL=
# URL do projeto e chave secreta (service_role) para o Storage das imagens: Project Settings → API
SUPABASE_URL=https://cbqflpapzmywfxcebjpa.supabase.co
SUPABASE_SERVICE_KEY=

# Acesso de administrador do painel (Histórico, Coleta e logs, Configuração). Use uma senha forte.
ADMIN_USER=
ADMIN_PASSWORD=

# Mapa de Obras: pasta onde fica o mapa_obras_cordeiro-PAINEL.html. A coleta diária importa o arquivo
# mais recente (só quando ele muda). Vazio: as obras são importadas só pelo painel (/obras).
OBRAS_PASTA=
